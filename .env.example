# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here

# Your Discord user ID (enables owner mode: roast battles, !reloadknowledge).
# Discord app → Settings → Advanced → Developer Mode → right-click your name → Copy User ID
OWNER_ID=

# LLM — any Ollama model works; prompts are tuned for SMALL models.
# Good small options: qwen3:4b, llama3.2:3b, phi3:mini, gemma3:4b, minimax-m2
OLLAMA_MODEL=phi3
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=90
OLLAMA_MAX_RETRIES=3
# Max tokens per reply — keeps small models from rambling
OLLAMA_NUM_PREDICT=180
OLLAMA_NUM_PREDICT_OWNER=500
TEMPERATURE=0.85

# Bot Settings
BOT_PREFIX=!
BOT_NAME=DaddyClintBot

# Database
DB_PATH=data/daddyclintbot.db

# Response Timing (CLI mode only)
MIN_DELAY=1.0
MAX_DELAY=15.0

# Logging
LOG_LEVEL=INFO

# Conversation memory (messages kept per user)
HISTORY_LENGTH=8

# News / catch-up (!news)
NEWS_LOOKBACK_HOURS=24

# Vibe report (!vibe) — eyes-in-the-sky analytics window
VIBE_LOOKBACK_HOURS=24

# ── !snapshot (on-demand server awareness; pull-only, no background work) ──
SNAPSHOT_ACCESS=owner                 # owner | staff | everyone
SNAPSHOT_DEFAULT_HOURS=6              # window when hours: not given (1–168)
SNAPSHOT_DEFAULT_DETAIL=medium        # low | medium | high
SNAPSHOT_TOP_CHANNELS=12              # channels listed in the embed (3–25)
SNAPSHOT_MAX_MSGS_PER_CHANNEL=60      # history() limit per channel
SNAPSHOT_CONCURRENCY=4                # parallel channel fetches
SNAPSHOT_CHANNEL_TIMEOUT=8            # seconds per channel
SNAPSHOT_MAX_SECONDS=25               # collection deadline (partial results after this)
SNAPSHOT_INCLUDE_BOTS=false           # count bot messages? (default excludes self-poisoning)
SNAPSHOT_MIN_MSGS_FOR_MOOD=3          # below this, mood shows n/a
SNAPSHOT_NEW_MEMBER_DAYS=7            # "new voice" threshold
SNAPSHOT_CACHE_TTL=300                # seconds; "fresh" bypasses
SNAPSHOT_CACHE_MAX_ENTRIES=8
SNAPSHOT_BREAKER_COOLDOWN=60          # seconds after 3 consecutive failures
SNAPSHOT_LLM_ENABLED=true             # false ⇒ deterministic summary only
SNAPSHOT_MODEL=                       # overrides OLLAMA_MODEL for the summary stage only
SNAPSHOT_LLM_NUM_PREDICT=220
SNAPSHOT_LLM_TIMEOUT=45               # seconds

# Proactive Engagement
PROACTIVE_ENABLED=true
PROACTIVE_THRESHOLD=0.75
PROACTIVE_CHANNEL_COOLDOWN=300
PROACTIVE_USER_COOLDOWN=60
PROACTIVE_MIN_LENGTH=15
PROACTIVE_CHANNELS=
PROACTIVE_BLOCKED_CHANNELS=admin,mod-logs,announcements
PROACTIVE_DRY_RUN=false
