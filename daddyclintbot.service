[Unit]
Description=DaddyClintBot Discord Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/daddyclint82/.openclaw/workspace/daddyclintbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/daddyclint82/.openclaw/workspace/daddyclintbot/venv/bin/python src/discord_bot.py
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM

[Install]
WantedBy=default.target
